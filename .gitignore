# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/
.worktrees/

# The LaTeX resume source lives in a separate private repository.
# It contains unpublished research detail and contact information, so keep the
# whole directory out of this public homepage repo.
# (To host a CV PDF on the site, publish it under files/ instead.)
resume/

# Ignore files created by MacOS
.DS_Store
